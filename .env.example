# =============================================================
# UrbanPulse - TiDB Cloud Serverless Connection Parameters
# =============================================================
# Obtain these credentials from your TiDB Cloud Console -> Connect -> General Client (MySQL)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=urbanpulse

# Mandatory TLS/SSL minVersion is enforced in api/db.ts:
# ssl: { minVersion: 'TLSv1.2', rejectUnauthorized: true }
